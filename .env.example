# Vault Bridge — Enterprise Environment Template
# Copy to .env and fill in your values
# docker compose -f docker-compose.enterprise.yml --env-file .env up -d

# =============================================================================
# REQUIRED - Vault Configuration
# =============================================================================
# Path to your Obsidian vault on the HOST machine
# Windows: VAULT_PATH=C:\Users\yourname\Documents\MyVault
# Linux/Mac: VAULT_PATH=/home/user/MyVault
# Docker: this gets mounted to /vault inside container
VAULT_PATH=./test-vault

# =============================================================================
# REQUIRED for HTTP/SSE transports - Authentication
# =============================================================================
# Generate with: openssl rand -hex 32
# Store in your secret manager (HashiCorp Vault, AWS Secrets Manager, Azure Key Vault)
VAULT_BRIDGE_API_KEY=changeme-generate-with-openssl-rand-hex-32

# =============================================================================
# OPTIONAL - Transport (defaults shown)
# =============================================================================
# OBSIDIAN_MCP_TRANSPORT=streamable-http   # stdio | sse | streamable-http
# OBSIDIAN_MCP_HOST=0.0.0.0
# OBSIDIAN_MCP_PORT=8000
# OBSIDIAN_MCP_PATH=/mcp

# =============================================================================
# OPTIONAL - Security/Compliance
# =============================================================================
# OBSIDIAN_MCP_READ_ONLY=false             # true for regulated environments
# OBSIDIAN_MCP_LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
# OBSIDIAN_MCP_LOG_JSON=true               # true for SIEM ingestion

# =============================================================================
# OPTIONAL - Rate Limiting (production: use Redis)
# =============================================================================
# OBSIDIAN_MCP_RATE_LIMIT_ENABLED=true
# OBSIDIAN_MCP_RATE_LIMIT_REQUESTS=100
# OBSIDIAN_MCP_RATE_LIMIT_WINDOW_SECONDS=60
# OBSIDIAN_MCP_RATE_LIMIT_STORAGE=memory   # memory | redis

# =============================================================================
# OPTIONAL - Redis (for distributed rate limiting)
# =============================================================================
# OBSIDIAN_MCP_REDIS_URL=redis://redis:6379/0

# =============================================================================
# OPTIONAL - Connection Pooling (opt-in)
# =============================================================================
# OBSIDIAN_MCP_POOL_SIZE=0
# OBSIDIAN_MCP_POOL_TIMEOUT=30

# =============================================================================
# OPTIONAL - Monitoring (uncomment and configure)
# =============================================================================
# GRAFANA_PASSWORD=admin